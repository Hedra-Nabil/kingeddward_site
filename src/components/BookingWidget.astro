---
export interface Props {
  targetId?: string;
  pickup?: string;
  source?: string;
  language?: string;
  surface?: string;
}

const {
  targetId = 'egyptlimo-booking',
  pickup,
  source = 'kingedwardtravel',
  language = 'en',
  surface,
} = Astro.props;
---
<div class="ke-clean-widget-wrap">
  <div id={targetId} class="ke-clean-widget-container"></div>
  <script
    is:inline
    src="https://booking.egyptlimo.com/widget.js"
    data-target={targetId}
    data-language={language}
    data-source={source}
    data-pickup={pickup}
    data-surface={surface}
    defer
  ></script>
</div>

<style>
  .ke-clean-widget-wrap {
    width: 100%;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }
  .ke-clean-widget-container {
    width: 100%;
    min-height: 80px;
  }
  /* Ensure iframe generated by widget expands to its full natural responsive width and height */
  .ke-clean-widget-container :global(iframe) {
    width: 100% !important;
    border: none !important;
    display: block !important;
    background: transparent !important;
  }
</style>
