---
import { KE_LIMO_URL, KE_LIMO_NAME, KE_LIMO_BLURB, KE_DMC_URL, KE_DMC_NAME, KE_DMC_BLURB } from '../data/siteConfig';
---
<!-- our group: transport + partner -->
<section class="category group-band">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="align-title">
                    <h5>One Team, Complete Egypt</h5>
                    <h3>Our Transport Company & Tour Partner</h3>
                </div>
            </div>
            <div class="col-lg-6 col-md-6">
                <div class="tour-package-container">
                    <div class="activities-image">
                        <a href={KE_LIMO_URL} target="_blank" rel="noopener"><img src="/assets/images/egypt/limo-airport.jpg" alt="Egypt Limo — airport transfers and shuttles"></a>
                    </div>
                    <div class="activities-content">
                        <div class="tour-package-info">
                            <div class="rating"><p><i class="fa-solid fa-circle-check"></i> Owned by King Edward</p></div>
                            <div class="doller">Private <span>Shuttle</span></div>
                        </div>
                        <a href='/private-transfer'>{KE_LIMO_NAME} — Transport Specialists</a>
                        <ul>
                            <li><i class="flaticon-placeholder"></i> {KE_LIMO_BLURB}</li>
                            <li style="margin-top: 8px;"><a href='/private-transfer' style="font-size: 14px; font-weight: 700; color: #FE7524;">Book Private Transfer Online →</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6">
                <div class="tour-package-container">
                    <div class="activities-image">
                        <a href={KE_DMC_URL} target="_blank" rel="noopener"><img src="/assets/images/egypt/dmc-group.jpg" alt="Egypt DMC — tours and trips partner"></a>
                    </div>
                    <div class="activities-content">
                        <div class="tour-package-info">
                            <div class="rating"><p><i class="fa-solid fa-handshake"></i> Trusted Partner</p></div>
                            <div class="doller">Trips <span>Tours</span></div>
                        </div>
                        <a href={KE_DMC_URL} target="_blank" rel="noopener">{KE_DMC_NAME} — Operations Partner</a>
                        <ul><li><i class="flaticon-placeholder"></i> {KE_DMC_BLURB}</li></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- our group end -->
