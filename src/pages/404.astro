---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page Not Found — King Edward Travel"
  headerClass="main-header style-one common-header"
  navActive=""
  mainHeading="Lost in the desert?"
  subHeading="404"
  noindex={true}
>
        <!-- error -->
        <div class="error">
            <div class="container">
                <div class="row">
                    <div class="col-lg-8 offset-lg-2">
                        <div class="error-container">
                            <div class="error-image">
                                <img src="/assets/images/egypt/pyramids-giza.jpg" alt="Giza pyramids" style="border-radius:12px;">
                            </div>
                            <p>The page you are looking for drifted off like desert sand. <br> Let's get you back to Egypt's wonders.</p>
                            <div class="btn-group">
                                <div class="header-link-btn"><a class='btn-1' href='/'> Back To Home<span></span></a></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- error -->
</BaseLayout>
