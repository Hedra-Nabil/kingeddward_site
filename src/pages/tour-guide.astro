---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Meet Our Licensed Egyptologists & Tour Managers | King Edward Travel"
  description="Meet the dedicated King Edward Travel team: senior tour managers, multilingual Egyptologist guides, Red Sea diving specialists, and our private A/C fleet drivers."
  keywords="Egyptologist tour guides, King Edward Travel team, private guide Cairo Luxor, Egypt tour managers"
  headerClass="main-header style-one common-header"
  navActive="tours"
  mainHeading="Meet Our Expert Egyptologists & Tour Managers"
  subHeading="Our Team"
>
        <!-- tour guide -->
        <section class="tour-guide tour-guid-page">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="align-title">
                            <h5>Our People</h5>
                            <h3>Meet the King Edward Team</h3>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="tour-guide-container">
                            <div class="tour-guid-image">
                                <span class="testimonial-initial team-initial">A</span>
                            </div>
                            <div class="tour-guid-content">
                                <span>King Edward Team</span>
                                <a href='/tour-details'>Ahmed El-Masry</a>
                                <p><strong>Senior Tour Manager.</strong> 20 years crafting Egypt itineraries for FIT, groups and incentives.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="tour-guide-container">
                            <div class="tour-guid-image">
                                <span class="testimonial-initial team-initial">M</span>
                            </div>
                            <div class="tour-guid-content">
                                <span>King Edward Team</span>
                                <a href='/tour-details'>Mona Hassan</a>
                                <p><strong>Egyptologist Guide.</strong> Brings Karnak, Giza and the Valley of the Kings to life in 3 languages.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="tour-guide-container">
                            <div class="tour-guid-image">
                                <span class="testimonial-initial team-initial">K</span>
                            </div>
                            <div class="tour-guid-content">
                                <span>King Edward Team</span>
                                <a href='/tour-details'>Karim Adel</a>
                                <p><strong>Red Sea Specialist.</strong> Diving and snorkeling trips in Sharm and Hurghada, PADI coordination.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="tour-guide-container">
                            <div class="tour-guid-image">
                                <span class="testimonial-initial team-initial">H</span>
                            </div>
                            <div class="tour-guid-content">
                                <span>King Edward Team</span>
                                <a href='/tour-details'>Heba Ibrahim</a>
                                <p><strong>Customer Care.</strong> Your 24/7 contact on tour — WhatsApp support from landing to takeoff.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="tour-guide-container">
                            <div class="tour-guid-image">
                                <span class="testimonial-initial team-initial">M</span>
                            </div>
                            <div class="tour-guid-content">
                                <span>King Edward Team</span>
                                <a href='/tour-details'>Mostafa Nabil</a>
                                <p><strong>Head Driver — Fleet.</strong> Leads our drivers across 15 A/C vehicles, from Hiace vans to 50-seat coaches.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="tour-guide-container">
                            <div class="tour-guid-image">
                                <span class="testimonial-initial team-initial">S</span>
                            </div>
                            <div class="tour-guid-content">
                                <span>King Edward Team</span>
                                <a href='/tour-details'>Sara Fouad</a>
                                <p><strong>Groups & Conferences.</strong> Corporate travel, conferences and incentive programs across Egypt.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="tour-guide-container">
                            <div class="tour-guid-image">
                                <span class="testimonial-initial team-initial">O</span>
                            </div>
                            <div class="tour-guid-content">
                                <span>King Edward Team</span>
                                <a href='/tour-details'>Omar Khalil</a>
                                <p><strong>Nile Cruise Expert.</strong> Knows every deck from Luxor to Aswan and across Lake Nasser.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="tour-guide-container">
                            <div class="tour-guid-image">
                                <span class="testimonial-initial team-initial">L</span>
                            </div>
                            <div class="tour-guid-content">
                                <span>King Edward Team</span>
                                <a href='/tour-details'>Layla Samy</a>
                                <p><strong>Reservations.</strong> Fast quotes and tailor-made offers — replies within 24 hours.</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>
        <!-- tour guide -->

        <!-- instagram feed -->
        <section class="inastagram-feed">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="instagram-title">
                            <h3><i class="fa-brands fa-instagram"></i> Egypt Moments</h3>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="instagram-container">
                <div class="instagram-content">
                    <div class="instagram-image">
                        <img src="/assets/images/egypt/pyramids-giza.jpg" alt="image">
                    </div>
                    <div class="instagram-overlay">
                      <div class="instagram-icon"><a href="/assets/images/egypt/pyramids-giza.jpg" class="lightbox-image" data-fancybox="gallery"><i class="fa-brands fa-instagram"></i></a></div>
                    </div>
                </div>
                <div class="instagram-content">
                    <div class="instagram-image">
                        <img src="/assets/images/egypt/karnak.jpg" alt="image">
                    </div>
                    <div class="instagram-overlay">
                      <div class="instagram-icon"><a href="/assets/images/egypt/karnak.jpg" class="lightbox-image" data-fancybox="gallery"><i class="fa-brands fa-instagram"></i></a></div>
                    </div>
                </div>
                <div class="instagram-content">
                    <div class="instagram-image">
                        <img src="/assets/images/egypt/aswan-nile.jpg" alt="image">
                    </div>
                    <div class="instagram-overlay">
                      <div class="instagram-icon"><a href="/assets/images/egypt/aswan-nile.jpg" class="lightbox-image" data-fancybox="gallery"><i class="fa-brands fa-instagram"></i></a></div>
                    </div>
                </div>
                <div class="instagram-content hide">
                    <div class="instagram-image">
                        <img src="/assets/images/egypt/sharm.jpg" alt="image">
                    </div>
                    <div class="instagram-overlay">
                      <div class="instagram-icon"><a href="/assets/images/egypt/sharm.jpg" class="lightbox-image" data-fancybox="gallery"><i class="fa-brands fa-instagram"></i></a></div>
                    </div>
                </div>
                <div class="instagram-content hide">
                    <div class="instagram-image">
                        <img src="/assets/images/egypt/luxor-balloon.jpg" alt="image">
                    </div>
                    <div class="instagram-overlay">
                      <div class="instagram-icon"><a href="/assets/images/egypt/luxor-balloon.jpg" class="lightbox-image" data-fancybox="gallery"><i class="fa-brands fa-instagram"></i></a></div>
                    </div>
                </div>
                <div class="instagram-content hide">
                    <div class="instagram-image">
                        <img src="/assets/images/egypt/hurghada.jpg" alt="image">
                    </div>
                    <div class="instagram-overlay">
                      <div class="instagram-icon"><a href="/assets/images/egypt/hurghada.jpg" class="lightbox-image" data-fancybox="gallery"><i class="fa-brands fa-instagram"></i></a></div>
                    </div>
                </div>
            </div>
        </section>
        <!-- instagram feed -->
</BaseLayout>
